    "notification.status.update_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is out of date. Update required"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ are versiune veche. Actualizare necesară."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist veraltet. Update erforderlich"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est obsolète. Mise à jour requise"
          }
        },
        "es": {
