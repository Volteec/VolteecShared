    "notification.status.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something new happened. Open the app to see what’s new."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A apărut o schimbare. Deschide aplicația pentru detalii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt Neuigkeiten. Öffne die App, um mehr zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose a changé. Ouvrez l’app pour voir les nouveautés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ocurrido una novedad. Abre la app para ver qué hay de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è qualcosa di nuovo. Apri l’app per vedere le novità."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Há novidades. Abre a app para ver o que há de novo."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "有新变化。打开应用查看详情。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新があります。アプリを開いて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 변경 사항이 있습니다. 앱을 열어 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Произошли новые события. Откройте приложение, чтобы узнать подробности."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzyło się coś nowego. Otwórz aplikację, aby zobaczyć szczegóły."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث شيء جديد. افتح التطبيق لمعرفة ما الجديد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קרה משהו חדש. פתח את האפליקציה כדי לראות מה חדש."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir şey oldu. Yenilikleri görmek için uygulamayı açın."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets nieuws gebeurd. Open de app om te zien wat er nieuw is."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Случи се нещо ново. Отворете приложението, за да видите какво е новото."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Догодило се нешто ново. Отворите апликацију да видите шта је ново."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι νέο συνέβη. Ανοίξτε την εφαρμογή για να δείτε τι νέο υπάρχει."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami új történt. Nyissa meg az alkalmazást a részletekhez."
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Tapahtui jotain uutta. Avaa sovellus nähdäksesi uutta.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Ada hal baru. Buka aplikasi untuk melihatnya.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "มีสิ่งใหม่เกิดขึ้น เปิดแอปเพื่อดูรายละเอียด",
            "state": "translated"
          }
        }
      }
    }
  },
  "version": "1.0"
