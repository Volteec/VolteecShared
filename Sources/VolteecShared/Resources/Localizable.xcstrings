    "notification.status.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something new happened. Open the app to see what’s new."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A apărut o schimbare. Deschide aplicația pentru detalii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt Neuigkeiten. Öffne die App, um mehr zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose a changé. Ouvrez l’app pour voir les nouveautés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ocurrido una novedad. Abre la app para ver qué hay de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è qualcosa di nuovo. Apri l’app per vedere le novità."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Há novidades. Abre a app para ver o que há de novo."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "有新变化。打开应用查看详情。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新があります。アプリを開いて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 변경 사항이 있습니다. 앱을 열어 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Произошли новые события. Откройте приложение, чтобы узнать подробности."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzyło się coś nowego. Otwórz aplikację, aby zobaczyć szczegóły."
          }
        }
      }
    }
